rules_version = '2';

// إعدادات أمان Firestore الخاصة بتطبيق "خصومات".
// حط الكود ده في Firebase Console -> Firestore Database -> Rules، أو انشره بـ:
//   firebase deploy --only firestore:rules
//
// ============================================================================
// ⚠️ تحديث مهم جدًا بعد إلغاء الاعتماد على Firebase Authentication تمامًا:
// ============================================================================
// التطبيق بقى بيستخدم دخول أدمن محلي فقط (مقارنة هاش SHA-256 لكلمة السر جوه
// المتصفح)، ومفيش أي تسجيل دخول حقيقي (لا للأدمن ولا Anonymous Auth) بيوصل
// لـ Firebase تاني. ده معناه إن request.auth هيفضل دايمًا null لأي طلب،
// سواء جاي من عميل عادي أو من الأدمن بعد ما يعدّي شاشة الدخول المحلية.
//
// عشان كده مستحيل تقنيًا إن قواعد Firestore (اللي بتشتغل على السيرفر) تفرّق
// بين "أدمن حقيقي" و"أي زائر عادي" أو تتحقق من ملكية عرض معيّن — القواعد دي
// معندهاش أي معلومة عن هوية اللي باعت الطلب أصلاً. فالقواعد تحت بقت مفتوحة
// (allow read, write: if true) على مستوى القراءة/الكتابة العادية، عشان
// التطبيق يفضل شغال بالظبط زي ما هو (نشر/تعديل/حذف عروض، موافقة الأدمن على
// الطلبات، إلخ) من غير ما يتكسر أي جزء منه.
//
// ⚠️ الأثر الأمني الحقيقي: شاشة دخول الأدمن المحلية (وكلمة السر المشفّرة)
// بتحمي واجهة التطبيق بس (تمنع ظهور لوحة التحكم لغير اللي عارف كلمة السر)،
// لكنها مبتمنعش حد يفتح "أدوات المطوّر" في المتصفح ويكلم Firestore مباشرة
// (يقرأ/يكتب/يحذف أي مستند في kv_store) من غير ما يمر على شاشة الدخول دي
// خالص، لو عرف اسم الكوليكشن وشكل البيانات. يعني الحماية الحقيقية دلوقتي
// بقت شبه معدومة على مستوى السيرفر، وكل الاعتماد بقى على التعتيم مش على
// تحقق فعلي من هوية اللي بيبعت الطلب. لو محتاج حماية سيرفر حقيقية تاني في
// المستقبل، الحل الصحيح الوحيد هو الرجوع لتسجيل دخول حقيقي (Firebase Auth
// أو أي نظام مصادقة تاني السيرفر يقدر يتحقق منه)، مش كلمة سر مقارَنة في
// المتصفح بس.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // كوليكشن admins بقى غير مستخدم فعليًا بعد إلغاء Firebase Auth (مفيش
    // أي حساب بيسجل دخول حقيقي يتحقق منه). سايبينه مقفول بالكامل للكتابة
    // احتياطًا، ومسموح بالقراءة بس لو حد محتاجه لأي غرض تاني مستقبلي.
    match /admins/{uid} {
      allow read: if true;
      allow write: if false;
    }

    match /kv_store/{docId} {
      // القراءة عامة للجميع (كتالوج الخصومات عام لكل الزوار زي ما التطبيق مصمم)
      allow read: if true;

      // الكتابة (إنشاء/تعديل/حذف) مفتوحة لأي طلب. زي ما موضّح فوق، مفيش أي
      // طريقة تقنية نفرّق بيها هنا بين الأدمن وأي زائر عادي بعد إلغاء
      // Firebase Auth بالكامل، فالحماية الوحيدة المتبقية هي شاشة دخول
      // الأدمن المحلية في واجهة التطبيق نفسها (JS)، مش قواعد السيرفر دي.
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }
  }
}
