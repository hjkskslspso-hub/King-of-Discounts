rules_version = '2';

// قواعد أمان Firebase Storage لتطبيق "خصومات".
// حطها من Firebase Console -> Storage -> Rules، أو انشرها بـ:
//   firebase deploy --only storage
//
// المنطق:
//   - القراءة (read): متاحة للجميع بدون أي تسجيل دخول، لازم عشان صور
//     العروض والإعلانات تظهر لكل زوار الموقع في الكتالوج العام.
//   - الرفع والتعديل والحذف (create / update / delete): متاحة فقط لأي
//     مستخدم عنده تسجيل دخول فعلي في Firebase Auth — سواء كان أدمن حقيقي
//     (Email/Password) أو زائر عادي مسجّل بدخول مجهول (Anonymous Auth).
//     التطبيق (index.html) بيسجّل كل زائر تلقائيًا بدخول مجهول لحظة ما
//     يفتح الصفحة (auth.signInAnonymously())، فده عمليًا بيغطي كل
//     المستخدمين الشرعيين (أصحاب المحلات وقت رفع صورة عرض، والأدمن وقت
//     رفع صورة إعلان) من غير ما يحتاجوا يعملوا أي حاجة إضافية، وفي نفس
//     الوقت بيمنع أي نداء مباشر غير مصرّح للـ Storage من برّه التطبيق
//     (زائر مفيش عنده أي جلسة Auth خالص).
//   - بالإضافة لشرط تسجيل الدخول، الرفع محدود بنوع الملف (صور/فيديوهات
//     فقط) وبحجم أقصى 8 ميجابايت، عشان نمنع رفع ملفات ضخمة أو غير مناسبة
//     حتى من حساب مسجّل دخول.
//
// ملحوظة: التطبيق بيحذف صورة/فيديو العرض أو الإعلان من Storage تلقائيًا
// لما يتحذف العرض من Firestore أو تتستبدل صورته بصورة جديدة (عشان الملفات
// القديمة متفضلش متراكمة على السيرفر من غير داعي)، وده بيحصل من نفس جلسة
// تسجيل الدخول المجهول اللي المستخدم داخل بيها، فمسموح له بالحذف زي ما هو موضّح فوق.

service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      // القراءة عامة (لازم عشان الصور تظهر لكل الزوار في كتالوج العروض)
      allow read: if true;

      // الرفع/التعديل: لازم يكون فيه تسجيل دخول (ولو مجهول)، وبيكون صورة
      // أو فيديو فقط، وبحجم معقول (8 ميجا كحد أقصى)
      allow create, update: if request.auth != null
                             && request.resource.size < 8 * 1024 * 1024
                             && request.resource.contentType.matches('image/.*|video/.*');

      // الحذف: متاح فقط لأي مستخدم عنده تسجيل دخول (حتى مجهول)، عشان
      // التطبيق يقدر ينضّف صور/فيديوهات العروض والإعلانات المحذوفة أو
      // المستبدلة تلقائيًا، ومحدش من برّه التطبيق (من غير أي جلسة Auth)
      // يقدر يحذف أي ملف.
      allow delete: if request.auth != null;
    }
  }
}
